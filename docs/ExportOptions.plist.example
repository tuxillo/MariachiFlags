<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- "ad-hoc" distributes to specific registered devices.
         Replace with "development" if using a development profile. -->
    <key>method</key>
    <string>ad-hoc</string>

    <!-- Your 10-character Apple Team ID (visible in developer.apple.com) -->
    <key>teamID</key>
    <string>XXXXXXXXXX</string>

    <!-- Must match the provisioning profile installed in the build step -->
    <key>provisioningProfiles</key>
    <dict>
        <key>com.mariachiflags.app</key>
        <string>MariachiFlags Ad Hoc</string>
    </dict>

    <key>signingStyle</key>
    <string>manual</string>

    <key>stripSwiftSymbols</key>
    <true/>

    <key>compileBitcode</key>
    <false/>

    <key>thinning</key>
    <string>&lt;none&gt;</string>
</dict>
</plist>
